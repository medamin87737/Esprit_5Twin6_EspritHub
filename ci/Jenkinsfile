// NutriTrace — CI seul (auto si changement Git front/back)
// Script Path : ci/Jenkinsfile
// IMPORTANT : décocher "Lightweight checkout"

pipeline {
    agent any

    // Poll Git toutes les 2 min → lance CI dès qu’il y a un commit (front ou back)
    triggers {
        pollSCM('H/2 * * * *')
    }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        HOST_DIR = "${env.HOST_PROJECT_DIR ?: '/workspace/nutritrace'}"
        // Nom du job CD dans Jenkins (adapter si ton job s’appelle autrement)
        CD_JOB   = 'CD'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "=== CI NutriTrace #${env.BUILD_NUMBER} (auto poll SCM) ==="
                sh 'ls -la | head -20'
            }
        }

        stage('Dependencies') {
            parallel {
                stage('Composer') {
                    steps {
                        sh '''
                            docker run --rm --dns 8.8.8.8 \
                              -v "${HOST_DIR}:/app" -w /app \
                              composer:2 \
                              composer install --no-interaction --prefer-dist --optimize-autoloader --ignore-platform-reqs
                        '''
                    }
                }
                stage('NPM') {
                    steps {
                        sh '''
                            docker run --rm --dns 8.8.8.8 \
                              -v "${HOST_DIR}:/app" -w /app \
                              node:22-alpine \
                              sh -c "npm ci || npm install"
                        '''
                    }
                }
            }
        }

        stage('Build assets') {
            steps {
                sh '''
                    docker run --rm --dns 8.8.8.8 \
                      -v "${HOST_DIR}:/app" -w /app \
                      node:22-alpine \
                      npm run build
                '''
            }
        }

        stage('Quality') {
            steps {
                sh '''
                    docker run --rm --dns 8.8.8.8 \
                      -v "${HOST_DIR}:/app" -w /app \
                      composer:2 \
                      sh -c "cp -n .env.example .env || true; php artisan --version || true"
                '''
            }
        }

        stage('Tests') {
            steps {
                sh '''
                    docker run --rm --dns 8.8.8.8 \
                      -v "${HOST_DIR}:/app" -w /app \
                      -e DB_CONNECTION=sqlite \
                      -e DB_DATABASE=/app/database/testing.sqlite \
                      composer:2 \
                      sh -c "mkdir -p database \
                        && touch database/testing.sqlite \
                        && cp -n .env.example .env \
                        && php artisan key:generate --force \
                        && php artisan test --testsuite=Unit"
                '''
            }
        }
    }

    post {
        success {
            echo "CI SUCCESS — #${env.BUILD_NUMBER} → déclenche CD"
            // CD automatique seulement si CI vert
            build job: "${env.CD_JOB}", wait: false, propagate: false
        }
        failure {
            echo "CI FAILURE — #${env.BUILD_NUMBER} — CD non lancé"
        }
    }
}
