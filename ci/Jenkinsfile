// NutriTrace — Pipeline CI (Intégration Continue)
// Script Path Jenkins : ci/Jenkinsfile
// IMPORTANT : décocher "Lightweight checkout"

pipeline {
    agent any

    triggers {
        pollSCM('H/2 * * * *')
    }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        HOST_DIR = "${env.HOST_PROJECT_DIR ?: '/workspace/nutritrace'}"
        CD_JOB   = 'CD'
    }

    stages {
        stage('1. Recuperation du code') {
            steps {
                checkout scm
                echo "=== CI NutriTrace #${env.BUILD_NUMBER} ==="
                sh 'ls -la | head -20'
            }
        }

        stage('2. Installation dependances') {
            parallel {
                stage('2a. Backend PHP (Composer)') {
                    steps {
                        sh '''
                            docker run --rm --dns 8.8.8.8 \
                              -v "${HOST_DIR}:/app" -w /app \
                              composer:2 \
                              composer install --no-interaction --prefer-dist --optimize-autoloader --ignore-platform-reqs
                        '''
                    }
                }
                stage('2b. Frontend Node (NPM)') {
                    steps {
                        sh '''
                            docker run --rm --dns 8.8.8.8 \
                              -v "${HOST_DIR}:/app" -w /app \
                              node:22-alpine \
                              sh -c "npm ci || npm install"
                        '''
                    }
                }
            }
        }

        stage('3. Build frontend Vite') {
            steps {
                sh '''
                    docker run --rm --dns 8.8.8.8 \
                      -v "${HOST_DIR}:/app" -w /app \
                      node:22-alpine \
                      npm run build
                '''
            }
        }

        stage('4. Verification qualite') {
            steps {
                sh '''
                    docker run --rm --dns 8.8.8.8 \
                      -v "${HOST_DIR}:/app" -w /app \
                      composer:2 \
                      sh -c "cp -n .env.example .env || true; php artisan --version || true"
                '''
            }
        }

        stage('5. Tests automatises') {
            steps {
                sh '''
                    docker run --rm --dns 8.8.8.8 \
                      -v "${HOST_DIR}:/app" -w /app \
                      -e DB_CONNECTION=sqlite \
                      -e DB_DATABASE=/app/database/testing.sqlite \
                      composer:2 \
                      sh -c "mkdir -p database \
                        && touch database/testing.sqlite \
                        && cp -n .env.example .env \
                        && php artisan key:generate --force \
                        && php artisan test --testsuite=Unit"
                '''
            }
        }
    }

    post {
        success {
            echo "CI REUSSI #${env.BUILD_NUMBER} — lancement automatique du CD"
            build job: "${env.CD_JOB}", wait: false, propagate: false
        }
        failure {
            echo "CI ECHOUE #${env.BUILD_NUMBER} — CD non lance"
        }
    }
}
