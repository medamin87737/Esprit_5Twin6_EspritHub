// NutriTrace — CI seul
// Script Path : ci/Jenkinsfile
// IMPORTANT Jenkins : décocher "Lightweight checkout"

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        skipDefaultCheckout(false)
    }

    environment {
        // Chemin HOST Windows pour docker run -v (socket Docker Desktop)
        HOST_DIR = "${env.HOST_PROJECT_DIR ?: '/workspace/nutritrace'}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "=== CI NutriTrace #${env.BUILD_NUMBER} ==="
                sh 'ls -la | head -20'
            }
        }

        stage('Dependencies') {
            parallel {
                stage('Composer') {
                    steps {
                        sh '''
                            docker run --rm \
                              -v "${HOST_DIR}:/app" -w /app \
                              composer:2 \
                              composer install --no-interaction --prefer-dist --optimize-autoloader --ignore-platform-reqs
                        '''
                    }
                }
                stage('NPM') {
                    steps {
                        sh '''
                            docker run --rm \
                              -v "${HOST_DIR}:/app" -w /app \
                              node:22-alpine \
                              sh -c "npm ci || npm install"
                        '''
                    }
                }
            }
        }

        stage('Build assets') {
            steps {
                sh '''
                    docker run --rm \
                      -v "${HOST_DIR}:/app" -w /app \
                      node:22-alpine \
                      npm run build
                '''
            }
        }

        stage('Quality') {
            steps {
                sh '''
                    docker run --rm \
                      -v "${HOST_DIR}:/app" -w /app \
                      composer:2 \
                      sh -c "cp -n .env.example .env || true; php artisan --version || true"
                '''
            }
        }

        stage('Tests') {
            steps {
                sh '''
                    # vendor déjà installé à l’étape Composer — pas de re-download
                    docker run --rm --dns 8.8.8.8 \
                      -v "${HOST_DIR}:/app" -w /app \
                      -e DB_CONNECTION=sqlite \
                      -e DB_DATABASE=/app/database/testing.sqlite \
                      composer:2 \
                      sh -c "mkdir -p database \
                        && touch database/testing.sqlite \
                        && cp -n .env.example .env \
                        && php artisan key:generate --force \
                        && php artisan test --testsuite=Unit"
                '''
            }
        }
    }

    post {
        success { echo "CI SUCCESS — #${env.BUILD_NUMBER}" }
        failure { echo "CI FAILURE — #${env.BUILD_NUMBER}" }
    }
}
