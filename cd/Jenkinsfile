// NutriTrace — Pipeline CD (Deploiement Continu)
// Script Path Jenkins : cd/Jenkinsfile
// IMPORTANT : décocher "Lightweight checkout"
//
// Docker-in-Docker (socket) :
// - build context = workspace Jenkins (.) — le client lit les fichiers dans le conteneur
// - compose = bind-mount /workspace/nutritrace (chemin Linux, pas //c/Users/...)
// - HOST_PROJECT_DIR (//c/...) sert uniquement aux volumes docker run (pipeline CI)

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    environment {
        // Bind-mount du projet (docker-compose.yml → jenkins volumes)
        APP_DIR = '/workspace/nutritrace'
        // Nom du projet Compose (= dossier Windows "laravelProject")
        COMPOSE_PROJECT = 'laravelproject'
    }

    stages {
        stage('1. Recuperation du code') {
            steps {
                checkout scm
                echo "=== CD NutriTrace #${env.BUILD_NUMBER} ==="
            }
        }

        stage('2. Construction image Docker') {
            steps {
                sh '''
                    docker build -t nutritrace:${BUILD_NUMBER} -t nutritrace:latest .
                    docker tag nutritrace:latest ${COMPOSE_PROJECT}-app:latest
                '''
            }
        }

        stage('3. Deploiement containers') {
            steps {
                sh '''
                    cd "${APP_DIR}"
                    docker compose -p "${COMPOSE_PROJECT}" up -d --no-build app db
                    docker compose -p "${COMPOSE_PROJECT}" ps
                '''
            }
        }

        stage('4. Test acces application') {
            steps {
                sh '''
                    sleep 8
                    curl -fsS -o /dev/null -w "%{http_code}\\n" http://host.docker.internal:8088/ \
                      || echo "Verifier http://127.0.0.1:8088"
                '''
            }
        }
    }

    post {
        success { echo "CD REUSSI — App en ligne : http://127.0.0.1:8088" }
        failure { echo "CD ECHOUE #${env.BUILD_NUMBER}" }
    }
}
