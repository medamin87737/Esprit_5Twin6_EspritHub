// NutriTrace — CD seul (déclenché auto après CI vert, ou Build Now manuel)
// Script Path : cd/Jenkinsfile
// IMPORTANT : décocher "Lightweight checkout"

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    environment {
        HOST_DIR = "${env.HOST_PROJECT_DIR ?: '/workspace/nutritrace'}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "=== CD NutriTrace #${env.BUILD_NUMBER} ==="
            }
        }

        stage('Build image') {
            steps {
                sh '''
                    docker build -t nutritrace:${BUILD_NUMBER} -t nutritrace:latest "${HOST_DIR}"
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    cd "${HOST_DIR}"
                    docker compose up -d --build app db
                    docker compose ps
                '''
            }
        }

        stage('Smoke test') {
            steps {
                sh '''
                    sleep 8
                    curl -fsS -o /dev/null -w "%{http_code}\\n" http://host.docker.internal:8088/ \
                      || echo "Vérifier http://127.0.0.1:8088"
                '''
            }
        }
    }

    post {
        success { echo "CD SUCCESS — http://127.0.0.1:8088" }
        failure { echo "CD FAILURE — #${env.BUILD_NUMBER}" }
    }
}
